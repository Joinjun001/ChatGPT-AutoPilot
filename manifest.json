{
  "manifest_version": 3,
  "name": "ChatGPT AutoPilot",
  "version": "0.1.2",
  "description": "ChatGPT 후속 프롬프트 자동 입력 실험",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://chatgpt.com/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "src/content.js"
      ]
    }
  ]
}
