{
  "manifest_version": 3,
  "name": "ChatGPT AutoPilot",
  "version": "0.3.1",
  "description": "플러그인으로 작업하는 ChatGPT 대화에 후속 프롬프트를 반복 전송해 작업을 반자동으로 이어 갑니다.",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "storage",
    "sidePanel"
  ],
  "host_permissions": [
    "https://chatgpt.com/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "ChatGPT AutoPilot 패널 열기"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "src/content.js"
      ]
    }
  ]
}
