diff --git a/test/audit.test.ts b/test/audit.test.ts
new file mode 100644
index 0000000..594352b
--- /dev/null
+++ b/test/audit.test.ts
@@ -0,0 +1,106 @@
+import { mkdtemp, readFile, rm, writeFile, readdir } from "node:fs/promises";
+import os from "node:os";
+import path from "node:path";
+import { afterEach, describe, expect, it } from "vitest";
+import { auditContext, recordAudit, resultMetadata, toolMetadata } from "../src/audit.js";
+import { runTool } from "../src/tool-result.js";
+import { loadConfig } from "../src/config.js";
+import { startHttpServer } from "../src/http-server.js";
+import { createServices } from "../src/mcp-server.js";
+
+describe("MCP JSONL 감사 로그",()=>{
+  const dirs:string[]=[];
+  afterEach(async()=>{for(const dir of dirs.splice(0)) await rm(dir,{recursive:true,force:true});});
+  it("스크립트·비밀값을 남기지 않고 명령 해시, 종료코드와 실행 ID만 기록한다",async()=>{
+    const dir=await mkdtemp(path.join(os.tmpdir(),"mcp-audit-"));dirs.push(dir);
+    const cwd=dir;
+    const before=process.env.MCP_AUDIT_DIR;
+    process.env.MCP_AUDIT_DIR=dir;
+    try{
+      const args={cmd:"echo api_key=SUPER_SECRET",env:{AUTOPILOT_RUN_ID:"run-12345678",AUTOPILOT_TURN:"18",PASSWORD:"SECRET"},workdir:cwd};
+      const meta=toolMetadata("tools/call","exec_command",args);
+      expect(meta.runId).toBe("run-12345678");
+      expect(meta.commandHash).toHaveLength(16);
+      await auditContext.run({requestId:"test-request-id",...meta},async()=>{
+        await runTool(async()=>({exitCode:7,stdout:"hello",stderr:"api_key=SUPER_SECRET",timedOut:false}));
+      });
+      let content="";
+      for(let i=0;i<30;i++){
+        content=await readFile(path.join(dir,"events.jsonl"),"utf8").catch(()=>"");
+        if(content.includes('"event":"tool_result"'))break;
+        await new Promise(resolve=>setTimeout(resolve,20));
+      }
+      const row=JSON.parse(content.trim());
+      expect(row.toolName).toBe("exec_command");
+      expect(row.exitCode).toBe(7);
+      expect(row.toolError).toBe(true);
+      expect(row.runId).toBe("run-12345678");
+      expect(row.turn).toBe(18);
+      expect(content).not.toContain("SUPER_SECRET");
+      expect(content).not.toContain("PASSWORD");
+      expect(content).not.toContain("echo api_key");
+      expect(row.stderrBytes).toBeGreaterThan(0);
+    }finally{
+      if(before===undefined) delete process.env.MCP_AUDIT_DIR;
+      else process.env.MCP_AUDIT_DIR=before;
+    }
+  });
+  it("2 MiB를 넘으면 파일을 회전시키고 기존 로그를 유지한다",async()=>{
+    const dir=await mkdtemp(path.join(os.tmpdir(),"mcp-rotate-"));dirs.push(dir);
+    await writeFile(path.join(dir,"events.jsonl"),"x".repeat(2*1024*1024));
+    await recordAudit(dir,{event:"test_rotate",requestId:"r1"});
+    const files=await readdir(dir);
+    expect(files.some(x=>/^events-\d+/.test(x))).toBe(true);
+    expect((await readFile(path.join(dir,"events.jsonl"),"utf8"))).toContain("test_rotate");
+  });
+  it("메타데이터 분류는 도구 오류와 HTTP 오류를 구분한다",()=>{
+    expect(resultMetadata({code:0,timedOut:false},false).toolError).toBe(false);
+    expect(resultMetadata({error:"EACCES on file"},true).errorCategory).toBe("permission");
+    expect(toolMetadata("tools/call","write_file",{content:"secret",path:"/tmp/x"}).argKeys).toContain("content");
+  });
+  it("실제 HTTP MCP 요청도 요청 로그와 도구 결과 로그를 남긴다",async()=>{
+    const dir=await mkdtemp(path.join(os.tmpdir(),"mcp-audit-http-"));dirs.push(dir);
+    const previous=process.env.MCP_AUDIT_DIR;process.env.MCP_AUDIT_DIR=dir;
+    const cfg=loadConfig({MCP_AUTH_TOKEN:"test-token",MCP_HOST:"127.0.0.1",MCP_DEFAULT_CWD:dir},dir);
+    cfg.port=0;
+    const server=await startHttpServer(cfg,createServices(cfg));
+    try{
+      const address=server.httpServer.address();
+      if(!address || typeof address==="string")throw Error("missing address");
+      const endpoint="http://127.0.0.1:"+address.port+cfg.endpoint;
+      const post=async(body:unknown)=>fetch(endpoint,{
+        method:"POST",
+        headers:{authorization:"Bearer test-token",accept:"application/json, text/event-stream","content-type":"application/json"},
+        body:JSON.stringify(body)
+      });
+      const response=await post({jsonrpc:"2.0",id:5,method:"tools/call",params:{
+        name:"exec_command",arguments:{
+          cmd:"exit 9",
+          workdir:dir,
+          env:{AUTOPILOT_RUN_ID:"run-76543210",AUTOPILOT_TURN:"3"},
+          yieldTimeMs:3000
+        }
+      }});
+      expect(response.status).toBe(200);
+      await response.text();
+      for(let i=0;i<60;i++){
+        const data=await readFile(path.join(dir,"events.jsonl"),"utf8").catch(()=>"");
+        if(data.includes('"event":"tool_result"') && data.includes('"event":"mcp_request"'))break;
+        await new Promise(resolve=>setTimeout(resolve,50));
+      }
+      const data=await readFile(path.join(dir,"events.jsonl"),"utf8");
+      const rows=data.trim().split("\n").map(x=>JSON.parse(x));
+      const tool=rows.find(x=>x.event==="tool_result");
+      const req=rows.find(x=>x.event==="mcp_request");
+      expect(tool.toolName).toBe("exec_command");
+      expect(tool.exitCode).toBe(9);
+      expect(tool.runId).toBe("run-76543210");
+      expect(req.requestId).toBe(tool.requestId);
+      expect(req.status).toBe(200);
+    }finally{
+      await server.close();
+      if(previous===undefined)delete process.env.MCP_AUDIT_DIR;
+      else process.env.MCP_AUDIT_DIR=previous;
+    }
+  });
+});
