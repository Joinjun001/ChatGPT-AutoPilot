+++ b/src/audit.ts
@@ -0,0 +1,84 @@
+/* 원격 MCP 요청 감사 로그. 인자/콘텐츠/인증값 원문은 저장하지 않는다. */
+import { AsyncLocalStorage } from "node:async_hooks";
+import { createHash } from "node:crypto";
+import { mkdir, open, readdir, rename, stat, unlink } from "node:fs/promises";
+import path from "node:path";
+
+export interface AuditContext {
+  requestId: string;
+  rpcMethod?: string;
+  toolName?: string;
+  runId?: string;
+  turn?: number;
+  argKeys?: string[];
+  commandHash?: string;
+  cwd?: string;
+}
+export const auditContext = new AsyncLocalStorage<AuditContext>();
+const MAX_FILE = 2 * 1024 * 1024;
+const MAX_ARCHIVES = 5;
+let writeChain: Promise<void> = Promise.resolve();
+
+const ascii = (x: unknown, max=128) => typeof x === "string" ? x.slice(0,max).replace(/[\r\n\x00-\x1f]/g, "") : undefined;
+function runIdFromArgs(args: unknown): {runId?:string;turn?:number} {
+  if (!args || typeof args !== "object" || Array.isArray(args)) return {};
+  const raw = args as Record<string,unknown>;
+  // 명령 본문·스크립트·stdin·파일 내용은 절대로 영속화하지 않는다.
+  const env = raw.env && typeof raw.env === "object" && !Array.isArray(raw.env) ? raw.env as Record<string,unknown> : {};
+  const id = env.AUTOPILOT_RUN_ID;
+  const turn = Number(env.AUTOPILOT_TURN);
+  return {
+    runId: typeof id === "string" && /^[a-zA-Z0-9-]{8,80}$/.test(id) ? id : undefined,
+    turn: Number.isInteger(turn) && turn >= 1 && turn <= 100000 ? turn : undefined,
+  };
+}
+export function toolMetadata(method: unknown, name: unknown, args: unknown): Partial<AuditContext> {
+  const x = args && typeof args === "object" && !Array.isArray(args) ? args as Record<string,unknown> : {};
+  const cmd = typeof x.cmd === "string" ? x.cmd : typeof x.script === "string" ? x.script : undefined;
+  const cwd = ascii(x.workdir ?? x.cwd, 200);
+  const match = cwd?.match(/^\/shared\/([a-zA-Z0-9가-힣_.-]+)(?:\/|$)/);
+  return {
+    rpcMethod: ascii(method, 80), toolName: ascii(name, 100),
+    argKeys: Object.keys(x).filter(k => k !== "__proto__").sort().slice(0,40).map(k=>ascii(k,70) || ""),
+    commandHash: cmd ? createHash("sha256").update(cmd).digest("hex").slice(0,16) : undefined,
+    cwd: cwd === "/shared" ? "/shared" : (match ? "/shared/" + match[1] : undefined),
+    ...runIdFromArgs(x),
+  };
+}
+export function resultMetadata(value: Record<string,unknown>, isError: boolean): Record<string,unknown> {
+  const exitCode = typeof value.exitCode === "number" ? value.exitCode : typeof value.code === "number" ? value.code : undefined;
+  const error = value.error;
+  const stderr = typeof value.stderr === "string" ? value.stderr : undefined;
+  return {
+    toolError: isError || (exitCode !== undefined && exitCode !== 0) || value.timedOut === true,
+    exitCode, timedOut: value.timedOut === true, running: value.running === true,
+    sessionId: typeof value.sessionId === "string" ? ascii(value.sessionId,80) : undefined,
+    errorCategory: typeof error === "string" ? (
+      /EACCES|EPERM|permission/i.test(error) ? "permission" :
+      /ENOENT|not found/i.test(error) ? "not_found" :
+      /timeout/i.test(error) ? "timeout" : "tool_error"
+    ) : undefined,
+    stderrBytes: stderr ? Buffer.byteLength(stderr) : undefined,
+  };
+}
+export function recordAudit(dir: string, event: Record<string,unknown>): Promise<void> {
+  // 직렬 append + 크기 단위 로테이션. 감사 실패는 실제 도구 실행을 막지 않는다.
+  const next = writeChain.catch(()=>undefined).then(async () => {
+    await mkdir(dir,{recursive:true,mode:0o700});
+    const file=path.join(dir,"events.jsonl");
+    const line=JSON.stringify({timestamp:new Date().toISOString(), ...event})+"\n";
+    try {
+      const info=await stat(file);
+      if(info.size + Buffer.byteLength(line) > MAX_FILE){
+        const archive=path.join(dir,"events-"+Date.now()+"-"+Math.random().toString(36).slice(2,8)+".jsonl");
+        await rename(file,archive);
+        const names=(await readdir(dir)).filter(n=>/^events-\d+-[\da-z]+\.jsonl$/.test(n)).sort().reverse();
+        await Promise.all(names.slice(MAX_ARCHIVES).map(n=>unlink(path.join(dir,n))));
+      }
+    }catch(err){if((err as NodeJS.ErrnoException).code !== "ENOENT") throw err;}
+    const handle=await open(file,"a",0o600);
+    try{await handle.appendFile(line,"utf8");}finally{await handle.close();}
+  }).catch((err)=>{console.error("MCP audit write failed:",err instanceof Error?err.message:"unknown error");});
+  writeChain=next;
+  return next;
+}
